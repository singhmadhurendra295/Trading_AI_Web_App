# Backend-specific .gitignore

# Virtualenvs
venv/
.venv/

# Compiled Python files
__pycache__/
*.py[cod]

# Logs
*.log
server_run.log

# Local configuration / secrets
.env
.env.*

# Model artifacts (do not commit large trained models)
models/saved_models/

# Testing / caches
.pytest_cache/
.mypy_cache/

# IDE
.vscode/
.idea/
